# Neon DB
# Pooled connection for your application
DATABASE_URL="postgresql://USER:PASSWORD@EP-pooler.REGION.aws.neon.tech/DB_NAME?sslmode=require"
# Direct connection for Prisma CLI workflows (migrations, db push, introspection)
DIRECT_URL="postgresql://USER:PASSWORD@EP.REGION.aws.neon.tech/DB_NAME?sslmode=require"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=

# App URL (e.g. http://localhost:3000 for local dev)
AUTH_URL=http://localhost:3000

# Google OAuth (also supported: GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Paystack Payment Gateway
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# GhanaNLP Khaya TTS
GHANANLP_API_KEY=
GHANANLP_API_KEY_SECONDARY=

# Google Gemini (AI Impact Summaries)
GOOGLE_AI_API_KEY=